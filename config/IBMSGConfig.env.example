# Copy this file to IBMSGConfig.env and fill in your values.
# DO NOT commit IBMSGConfig.env — it is listed in .gitignore.

SN_INSTANCE_URL=https://<your-instance>.service-now.com
SN_USERNAME=<your-username>
SN_PASSWORD=<your-password>
SN_WORKSPACE_PATH=/now/sow/home
OUTPUT_FOLDER=./output
TIMEOUT_SECONDS=30
